# RetailPulse AI Configuration
# Note: The system runs 100% locally out-of-the-box using the built-in Grounded Semantic Engine.
# To connect to live cloud LLM providers, provide your API key below:

# Google Gemini API Key (Recommended: gemini-2.5-flash / gemini-1.5-flash)
GEMINI_API_KEY=

# OpenAI API Key (Optional: gpt-4o / gpt-4o-mini)
OPENAI_API_KEY=

# Default Provider: "gemini", "openai", or "heuristic"
DEFAULT_LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-2.5-flash

# Application Settings
DEBUG=false
INACTIVE_CUSTOMER_DAYS=90
